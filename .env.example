# Keep this file as a template only. Store real values in storage/private/.env
# or in the hosting provider's server environment.

# Current PHP application mode. Set to pgsql after installing pdo_pgsql and
# running supabase/recyclon_supabase.sql.
DB_DRIVER=pgsql
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Supabase direct PostgreSQL connection. Never expose this URL to browser code.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@HOSTED_SUPABASE_HOST:5432/postgres

APP_ENCRYPTION_KEY=
RECYCLON_GPS_API_KEY=
DEFAULT_TEMP_PASSWORD=
ENFORCE_HTTPS=false

# Public Supabase API settings are only needed if browser Supabase features are
# added later. Never put the secret/service-role key in frontend JavaScript.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json